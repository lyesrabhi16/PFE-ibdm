[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = "*"
djangorestframework = "*"
mssql-django = "*"
drf-spectacular = {extras = ["sidecar"], version = "*"}
setuptools = "*"
django-jazzmin = "*"
pillow = "*"
channels = {extras = ["daphne"], version = "*"}
twisted = {extras = ["http2", "tls"], version = "*"}
django-cors-headers = "*"
django-filter = "*"
python-decouple = "*"
django-crispy-forms = "*"
daphne = "*"
channels-redis = "*"
apscheduler = "*"
openpyxl = "*"
whitenoise = "*"
django-cachalot = "*"

[requires]
python_version = "3.12.9"

[scripts]
"start_server" = "cd ibdm_api && daphne -e ssl:8443:privateKey=certs/ibdm.key:certKey=certs/ibdm.crt ibdm_api.asgi:application"
"link_docker" = "docker-machine env | Invoke-Expression"
"start_dev" = "cd ibdm_api && python manage.py runserver"
"migrate"  = "cd ibdm_api && python manage.py makemigrations && python manage.py migrate"
"createsuperuser" = "cd ibdm_api && python manage.py createsuperuser"
"generate_schema_json" = "cd ibdm_api && python ibdm_api/manage.py spectacular --file ibdm_api/openapi/openapi.spec.json --format openapi-json --validate --fail-on-warn"

[dev-packages]
