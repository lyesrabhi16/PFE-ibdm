[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
djangorestframework = "*"
mssql-django = "*"
drf-spectacular = {extras = ["sidecar"], version = "*"}
setuptools = "*"
django-jazzmin = "*"
pillow = "*"
channels = {extras = ["daphne"], version = "*"}
django-cors-headers = "*"
django-filter = "*"
python-decouple = "*"
django-crispy-forms = "*"
channels-redis = "*"
apscheduler = "*"
openpyxl = "*"
whitenoise = "*"
django-cachalot = "*"
tenacity = "*"
psutils = "*"
psutil = "*"
cryptography = "*"
django = {extras = ["argon2"], version = "*"}
hypercorn = "*"

[requires]
python_version = "3.12.9"

[scripts]
"start_server" = "cd ibdm_api && hypercorn ibdm_api.asgi:application --bind 0.0.0.0:8443 --workers 1 --certfile certs/ibdm.crt --keyfile certs/ibdm.key --access-logfile data/logs/http.log --error-logfile data/logs/http_error.log"
"link_docker" = "echo docker-machine env default | Invoke-Expression"
"start_dev" = "cd ibdm_api && python manage.py runserver"
"migrate"  = "cd ibdm_api && python manage.py makemigrations && python manage.py migrate"
"createsuperuser" = "cd ibdm_api && python manage.py createsuperuser"
"generate_schema_json" = "python ibdm_api/manage.py spectacular --file ibdm_api/openapi/openapi.spec.json --format openapi-json --validate --fail-on-warn"

[dev-packages]
