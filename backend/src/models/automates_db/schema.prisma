generator automateClient {
  provider = "prisma-client-js"
  output   = "./generated/automateClient"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource automate_db {
  provider = "sqlserver"
  url      = env("SQLSERVER_DATABASE_URL")
}

model Table_date {
  id Int @id(map: "PK_table_date") @default(dbgenerated()) @automate_db.Int
  date DateTime?

}

model test_table {
  id Int @automate_db.Int @id(map: "PK_test_table") @default(autoincrement())
  test_table_str String? @automate_db.NChar(10)

}
