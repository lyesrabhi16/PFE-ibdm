# --- How configuration works ------------------------------------------------
# The server reads `ibdm_api/settings.json`. That file is created/rewritten on
# every start (secrets are stored encrypted) and is editable from the web app
# (Server Status > Settings, admin only). On first start, or when settings.json
# is missing a key, values come from environment variables / this .env file.
# Database and Redis connections live under the `DATABASES` and `REDIS_DB`
# keys of settings.json; the DATABASE_*/REDIS vars below are the bootstrap values.
#
# DEBUG=True is needed to run the Flutter app from another origin (e.g. `flutter run -d chrome`).
# Leave it unset (False) in production: it also tightens CORS and cookie settings.
DEBUG = True

ENV_MODE = "development"
SECRET_KEY = "change-me" # generate with: python -c "import secrets; print(secrets.token_hex(50))"


DATABASE_IBDM_NAME = "ibdm"
DATABASE_IBDM_USER = "sa"
DATABASE_IBDM_PASSWORD = "change-me"
DATABASE_IBDM_HOST = "localhost"
DATABASE_IBDM_PORT = "1433"

DATABASE_IBDM_REDIS_HOST = "localhost"
DATABASE_IBDM_REDIS_PORT = "63793"

DATABASE_AUTOMATE_NAME = "automate"
DATABASE_AUTOMATE_USER = "sa"
DATABASE_AUTOMATE_PASSWORD = "change-me"
DATABASE_AUTOMATE_HOST = "localhost"
DATABASE_AUTOMATE_PORT = "1433"

DATABASE_SIROPERIE_NAME = "siroperie"
DATABASE_SIROPERIE_USER = "sa"
DATABASE_SIROPERIE_PASSWORD = "change-me"
DATABASE_SIROPERIE_HOST = "localhost"
DATABASE_SIROPERIE_PORT = "1433"

DATABASE_FILTRATION_NAME = "Filtration"
DATABASE_FILTRATION_USER = "sa"
DATABASE_FILTRATION_PASSWORD = "change-me"
DATABASE_FILTRATION_HOST = "localhost"
DATABASE_FILTRATION_PORT = "1433"

DATABASE_UTILITE_NAME = "Utilite"
DATABASE_UTILITE_USER = "sa"
DATABASE_UTILITE_PASSWORD = "change-me"
DATABASE_UTILITE_HOST = "localhost"
DATABASE_UTILITE_PORT = "1433"


EMAIL_HOST = 'smtp.example.com'
EMAIL_USE_TLS = True
EMAIL_PORT = 587
EMAIL_HOST_USER = "User@ifri-dz.local" #sender's email-id
EMAIL_HOST_PASSWORD = "Pass"
