{
  "cli": {
    "version": ">= 13.4.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "ENABLE_HTTP": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production",
        "ENABLE_HTTP": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "production",
        "ENABLE_HTTP": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
