{
	"name": "backend",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev:server": "cd backend2 && pipenv run start_https",
		"dev:app": "cd frontend3/ibdm && flutter run",
		"dev:web": "cd frontend3/ibdm && flutter run -d chrome",
		"dev:web:external": "cd frontend3/ibdm && flutter run -d chrome --web-hostname app.ibdm.local.ifri --web-port 8001",
		"deploy:copy-assets": "cp -r frontend3/ibdm/build/web/* backend2/ibdm_api/assets/",
		"deploy:web": "pnpm run build:web && pnpm run deploy:copy-assets",
		"dev:windows": "cd frontend3/ibdm && flutter run -d windows",
		"dev:macos": "cd frontend3/ibdm && flutter run -d macos",
		"dev:linux": "cd frontend3/ibdm && flutter run -d linux",
		"dev:build:android": "cd frontend3/ibdm/android && ./gradlew clean build && echo 'Build Done' && echo 'You can start the app now'",
		"build:windows": "cd frontend3/ibdm && flutter build windows",
		"build:android": "cd frontend3/ibdm && flutter build apk",
		"build:web": "cd frontend3/ibdm && flutter build web",
		"build:ios": "cd frontend3/ibdm && flutter build ios",
		"build:macos": "cd frontend3/ibdm && flutter build macos",
		"build:linux": "cd frontend3/ibdm && flutter build linux",
        "sql_server_db:up": "cd backend/config/db && docker compose -f sql_server.yaml up -d",
		"generate:api-client": "cd backend2 && pipenv run generate_schema_json && cd .. && copy .\\backend2\\ibdm_api\\openapi\\openapi.spec.json .\\frontend3\\ibdm\\lib\\api\\ && cd frontend3/ibdm && rmdir /S /Q lib\\services\\api_django"
	},
	"keywords": [],
	"author": "",
	"license": "Apache-2.0",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.2.1",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.7",
		"@vinejs/vine": "^3.0.0",
		"argon2": "^0.41.1",
		"bcryptjs": "^2.4.3",
		"body-parser": "^1.20.3",
		"connect-mongo": "^5.1.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.1",
		"express-session": "^1.18.1",
		"multer": "1.4.5-lts.1",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"winston": "^3.17.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@openapitools/openapi-generator-cli": "^2.15.3",
		"@types/bcryptjs": "^2.4.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/express-session": "^1.18.1",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.9.0",
		"prisma": "^6.2.1",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3"
	},
	"prisma": {
		"schema": "./backend/src/models/ibdm_db/",
		"seed": "tsx src/models/seed.ts"
	},
	"packageManager": "pnpm@9.14.4+sha512.c8180b3fbe4e4bca02c94234717896b5529740a6cbadf19fa78254270403ea2f27d4e1d46a08a0f56c89b63dc8ebfd3ee53326da720273794e6200fcf0d184ab"
}