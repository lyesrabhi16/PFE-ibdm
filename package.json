{
	"name": "backend",
	"version": "1.0.0",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"start": "cd backend && tsx server.ts --host 0.0.0.0",
		"dev": "cd backend && tsx watch server.ts --host 0.0.0.0",
		"prisma:migrate": "cd backend && prisma migrate dev",
		"prisma:generate": "cd backend && prisma generate",
		"prisma:push": "cd backend && prisma db push",
		"prisma:seed": "cd backend && prisma db seed",
		"prisma:studio": "cd backend && prisma studio",
		"dev:build:android": "cd frontend3/ibdm/android && ./gradlew clean build && echo 'Build Done' && echo 'You can start the app now'",
		"bulid:android": "cd frontend3/ibdm && flutter build apk",
		"generate:api-client": "cp backend/openapi.json frontend3/ibdm/lib/api && cd frontend3/ibdm && dart run swagger_parser && dart run build_runner build"
	},
